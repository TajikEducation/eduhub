# Copy to .env and fill in real values for local development.
# Never commit the real .env file.

# Runtime environment: dev | test | staging | prod.
# Gates dev-only behavior such as `make seed` (cmd/devseed).
APP_ENV=dev

# Address the HTTP server listens on.
HTTP_ADDR=:8080

# PostgreSQL connection string (PostGIS-enabled instance, see docker-compose.yml).
DATABASE_URL=postgres://eduhub:eduhub@localhost:5433/eduhub?sslmode=disable

# slog level: debug | info | warn | error.
LOG_LEVEL=info
