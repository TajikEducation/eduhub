# Скопировать в .env и заполнить реальными значениями для локальной разработки.
# Реальный файл .env никогда не коммитить.

# Окружение выполнения: dev | test | staging | prod.
# Управляет dev-специфичным поведением, например `make seed` (cmd/devseed).
APP_ENV=dev

# Адрес, на котором слушает HTTP-сервер.
HTTP_ADDR=:8080

# Строка подключения к PostgreSQL (инстанс с PostGIS, см. docker-compose.yml).
DATABASE_URL=postgres://eduhub:eduhub@localhost:5433/eduhub?sslmode=disable

# Адрес Redis (кэш каталога, см. docker-compose.yml). Недоступность деградирует
# запросы к прямому обращению в БД — не входит в /readyz.
REDIS_ADDR=localhost:6380

# Уровень логирования slog: debug | info | warn | error.
LOG_LEVEL=info

# Время ожидания завершения активных запросов при graceful shutdown (формат time.Duration).
SHUTDOWN_TIMEOUT=10s

# Разрешённые CORS origin'ы через запятую. Пусто — CORS ничего не разрешает (fail-closed).
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Параметры стоимости argon2id (E2.2, internal/auth/password). Все опциональны — пусто
# означает "взять password.DefaultParams". PHC-строка хеша несёт свои параметры, поэтому
# смена значений здесь не инвалидирует уже выданные пароли.
ARGON_MEMORY_KIB=65536
ARGON_ITERATIONS=3
ARGON_PARALLELISM=4
