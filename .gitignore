# IDE
.idea/
.vscode/
.DS_Store

# Git worktrees (local scratch, not part of history)
.worktrees/

# Environment
.env
.env.*

# Claude Code — local files (not committed)
CLAUDE.local.md
.claude/

# AI agent tooling (installed skill/agent bundles, not project code)
.agents/
.codex/
.impeccable/
agent/
claude-talk-to-figma-mcp/
skills-lock.json
.mcp.json

# graphify knowledge-graph (repo root only) — cache/converted/counters are regenerable
# scratch state, ignored; the graph itself and the wiki are committed as project docs.
/graphify-out/*
!/graphify-out/graph.json
!/graphify-out/graph.html
!/graphify-out/GRAPH_REPORT.md
!/graphify-out/wiki/
!/graphify-out/wiki/**

# stray graphify-out dirs elsewhere (e.g. old web/-scoped runs) — always fully ignored
web/graphify-out/

# Node / build (frontend)
node_modules/
dist/
build/
.next/
*.log

# Go / build (backend)
bin/
*.exe
*.dll
*.so
*.dylib
*.test
*.out
coverage.html
coverage.txt
